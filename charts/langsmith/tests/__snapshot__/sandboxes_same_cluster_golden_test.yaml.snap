aks-identity:
  1: |
    apiVersion: v1
    kind: Secret
    metadata:
      annotations:
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        argocd.argoproj.io/sync-wave: "-2"
        helm.sh/chart: langsmith-0.0.0-golden
      labels:
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        helm.sh/chart: langsmith-0.0.0-golden
      name: langsmith-juicefs-config
      namespace: langsmith
    stringData:
      bucket: https://langsmith-sandboxes-test.s3.us-west-2.amazonaws.com
      metaurl: redis://langsmith-redis.default.svc.cluster.local:6379/1
      name: sandbox-juicefs
      storage: s3
    type: Opaque
  2: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        argocd.argoproj.io/sync-wave: "-1"
        helm.sh/chart: langsmith-0.0.0-golden
      labels:
        app.kubernetes.io/component: juicefs-format
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        helm.sh/chart: langsmith-0.0.0-golden
      name: langsmith-juicefs-format-54d3a646
      namespace: langsmith
    spec:
      activeDeadlineSeconds: 900
      backoffLimit: 3
      completions: 1
      parallelism: 1
      template:
        metadata:
          labels:
            app.kubernetes.io/component: juicefs-format
            app.kubernetes.io/instance: langsmith
            app.kubernetes.io/name: langsmith
            azure.workload.identity/use: "true"
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - --internal-juicefs-format
              command:
                - /opt/sandbox-host/bin/sandbox-host
              env:
                - name: LANGCHAIN_ENV
                  valueFrom:
                    configMapKeyRef:
                      key: LANGCHAIN_ENV
                      name: langsmith-config
              image: example.com/langsmith/sandbox-host:test-sandbox-host
              imagePullPolicy: IfNotPresent
              name: juicefs-format
              resources:
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - mountPath: /run/secrets/juicefs
                  name: juicefs-config
                  readOnly: true
          nodeSelector:
            sandbox.langsmith.com/host: "true"
          restartPolicy: Never
          securityContext: {}
          serviceAccountName: langsmith-sandbox-host
          tolerations:
            - effect: NoSchedule
              key: sandbox.langsmith.com/host
              operator: Equal
              value: "true"
          volumes:
            - name: juicefs-config
              secret:
                defaultMode: 256
                secretName: langsmith-juicefs-config
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        helm.sh/chart: langsmith-0.0.0-golden
      labels:
        app: sandbox-host
        app.kubernetes.io/component: langsmith-sandbox-host
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        azure.workload.identity/use: "true"
        helm.sh/chart: langsmith-0.0.0-golden
      name: langsmith-sandbox-host
      namespace: langsmith
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: langsmith-sandbox-host
          app.kubernetes.io/instance: langsmith
          app.kubernetes.io/name: langsmith
      strategy:
        rollingUpdate:
          maxSurge: 0
          maxUnavailable: 1
        type: RollingUpdate
      template:
        metadata:
          annotations:
            checksum/juicefs-config: 4359f0855b32b59d7a57b1bf1b0d16be408b7431cb3fcad4fb7f2ba91c8ad177
          labels:
            app: sandbox-host
            app.kubernetes.io/component: langsmith-sandbox-host
            app.kubernetes.io/instance: langsmith
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: langsmith
            azure.workload.identity/use: "true"
        spec:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: langsmith-sandbox-host
                      app.kubernetes.io/instance: langsmith
                      app.kubernetes.io/name: langsmith
                  topologyKey: kubernetes.io/hostname
          automountServiceAccountToken: true
          containers:
            - env:
                - name: LANGCHAIN_ENV
                  value: local_kubernetes
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: POD_UID
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.uid
                - name: POD_HOST_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: LANGSMITH_APP_VERSION
                  value: test-sandbox-host
                - name: SANDBOX_X_SERVICE_AUTH_JWT_SECRET
                  valueFrom:
                    secretKeyRef:
                      key: api_key_salt
                      name: langsmith-secrets
                      optional: false
                - name: SANDBOX_HOST_PROXY_CA_DIR
                  value: /certs
                - name: LANGSMITH_SANDBOX_CALLBACK_SIGNING_JWK
                  valueFrom:
                    secretKeyRef:
                      key: sandbox_callback_signing_jwk
                      name: langsmith-secrets
                      optional: true
                - name: SSRF_ALLOW_PRIVATE_IPS_CALLBACKS
                  value: "true"
                - name: SANDBOX_CALLBACK_LOOPBACK_REWRITE
                  value: "false"
                - name: SANDBOX_EGRESS_UPSTREAM_PROXY_URL
                  valueFrom:
                    secretKeyRef:
                      key: sandbox_egress_proxy_url
                      name: langsmith-secrets
                      optional: true
                - name: LANGSMITH_SANDBOX_INTERNAL_ENDPOINT
                  value: http://langsmith-platform-backend.langsmith.svc.cluster.local:1986
                - name: SANDBOX_HOST_DEPLOYMENT_NAME
                  value: langsmith-sandbox-host
                - name: SANDBOX_HOST_TERMINATION_GRACE_SECONDS
                  value: "300"
                - name: SANDBOX_HOST_JUICEFS_META_URL_FILE
                  value: /run/secrets/juicefs/metaurl
                - name: SANDBOX_HOST_JUICEFS_MOUNT_OPTIONS
                  value: '["--cache-dir=/var/cache/juicefs","--cache-size=51200","--cache-large-write"]'
                - name: SANDBOX_HOST_AUTOSCALE_ENABLED
                  value: "false"
              image: example.com/langsmith/sandbox-host:test-sandbox-host
              imagePullPolicy: IfNotPresent
              name: sandbox-host
              ports:
                - containerPort: 19190
                  hostPort: 19190
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                initialDelaySeconds: 5
                periodSeconds: 10
                tcpSocket:
                  port: http
                timeoutSeconds: 3
              resources:
                requests:
                  cpu: "2"
                  memory: 2Gi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /juicefs
                  name: juicefs
                - mountPath: /var/cache/juicefs
                  name: juicefs-cache-0
                - mountPath: /run/secrets/juicefs
                  name: juicefs-meta
                  readOnly: true
                - mountPath: /host-bin
                  name: host-bin
                - mountPath: /certs
                  name: proxy-ca
                  readOnly: true
          dnsConfig:
            options:
              - name: ndots
                value: "4"
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          nodeSelector:
            sandbox.langsmith.com/host: "true"
          securityContext: {}
          serviceAccountName: langsmith-sandbox-host
          terminationGracePeriodSeconds: 300
          tolerations:
            - effect: NoSchedule
              key: sandbox.langsmith.com/host
              operator: Equal
              value: "true"
          volumes:
            - emptyDir: {}
              name: juicefs
            - hostPath:
                path: /var/cache/juicefs
                type: DirectoryOrCreate
              name: juicefs-cache-0
            - name: juicefs-meta
              secret:
                defaultMode: 256
                items:
                  - key: metaurl
                    path: metaurl
                secretName: langsmith-juicefs-config
            - name: proxy-ca
              secret:
                secretName: sandbox-proxy-ca
            - hostPath:
                path: /var/lib/sandbox-host
                type: DirectoryOrCreate
              name: host-bin
