        app.kubernetes.io/version: 0.0.0-golden
        helm.sh/chart: langsmith-0.0.0-golden
      labels:
        app.kubernetes.io/instance: langsmith
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith
        app.kubernetes.io/version: 0.0.0-golden
        helm.sh/chart: langsmith-0.0.0-golden
