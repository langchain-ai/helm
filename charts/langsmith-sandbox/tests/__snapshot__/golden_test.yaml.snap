aks:
  1: |
    apiVersion: v1
    kind: Secret
    metadata:
      annotations:
        argocd.argoproj.io/sync-wave: "-2"
      labels:
        app.kubernetes.io/instance: langsmith-sandbox
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith-sandbox
        helm.sh/chart: langsmith-sandbox-0.0.0-golden
      name: langsmith-sandbox-juicefs-config
      namespace: langsmith-sandbox
    stringData:
      access-key: langsmithsandbox
      bucket: https://juicefs.blob.core.windows.net
      metaurl: rediss://langsmith-sandbox.westus2.redis.azure.net:10000/0
      name: sandbox-juicefs
      storage: wasb
    type: Opaque
  2: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        argocd.argoproj.io/sync-wave: "-1"
      labels:
        app.kubernetes.io/component: juicefs-format
        app.kubernetes.io/instance: langsmith-sandbox
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: langsmith-sandbox
        helm.sh/chart: langsmith-sandbox-0.0.0-golden
      name: langsmith-sandbox-juicefs-format-66251a60
      namespace: langsmith-sandbox
    spec:
      activeDeadlineSeconds: 900
      backoffLimit: 3
      completions: 1
      parallelism: 1
      template:
        metadata:
          annotations: null
          labels:
            app.kubernetes.io/component: juicefs-format
            app.kubernetes.io/instance: langsmith-sandbox
            app.kubernetes.io/name: langsmith-sandbox
            azure.workload.identity/use: "true"
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - --internal-juicefs-format
              command:
                - /opt/sandbox-host/bin/sandbox-host
              env:
                - name: LANGCHAIN_ENV
                  value: local_kubernetes
                - name: SANDBOX_HOST_JUICEFS_REDIS_IAM_AUTH_PROVIDER
                  value: azure
              image: docker.io/langchain/sandbox-host:0.0.0-golden
              imagePullPolicy: IfNotPresent
              name: juicefs-format
              resources:
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - mountPath: /run/secrets/juicefs
                  name: juicefs-config
                  readOnly: true
          dnsConfig:
            options:
              - name: ndots
                value: "4"
          nodeSelector:
            sandbox.langsmith.com/host: "true"
          restartPolicy: Never
          securityContext: {}
          serviceAccountName: langsmith-sandbox-host
          tolerations:
            - effect: NoSchedule
              key: sandbox.langsmith.com/host
              operator: Equal
              value: "true"
          volumes:
            - name: juicefs-config
              secret:
                defaultMode: 256
                secretName: langsmith-sandbox-juicefs-config
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations: null
      labels:
        app: sandbox-host
        app.kubernetes.io/component: langsmith-sandbox-sandbox-host
        app.kubernetes.io/instance: langsmith-sandbox
