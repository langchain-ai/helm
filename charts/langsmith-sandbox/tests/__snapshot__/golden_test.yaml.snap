        helm.sh/chart: langsmith-sandbox-0.0.0-golden
      name: langsmith-sandbox-sandbox-host
      namespace: langsmith-sandbox
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: langsmith-sandbox-sandbox-host
          app.kubernetes.io/instance: langsmith-sandbox
          app.kubernetes.io/name: langsmith-sandbox
      strategy:
        rollingUpdate:
          maxSurge: 0
          maxUnavailable: 1
        type: RollingUpdate
      template:
        metadata:
          annotations:
            checksum/juicefs-config: 29af195818d17646eb34bcb3287201a4ac8a7c45d44723ccf92a46be58a9cbc6
          labels:
            app: sandbox-host
            app.kubernetes.io/component: langsmith-sandbox-sandbox-host
            app.kubernetes.io/instance: langsmith-sandbox
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: langsmith-sandbox
            azure.workload.identity/use: "true"
        spec:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: langsmith-sandbox-sandbox-host
                      app.kubernetes.io/instance: langsmith-sandbox
                      app.kubernetes.io/name: langsmith-sandbox
                  topologyKey: kubernetes.io/hostname
          automountServiceAccountToken: true
          containers:
            - env:
                - name: LANGCHAIN_ENV
                  value: local_kubernetes
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: POD_UID
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.uid
                - name: POD_HOST_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: SANDBOX_X_SERVICE_AUTH_JWT_SECRET
                  valueFrom:
                    secretKeyRef:
                      key: sandbox_service_auth_secret
                      name: langsmith-sandbox-runtime
                - name: SANDBOX_HOST_PROXY_CA_DIR
                  value: /certs
                - name: LANGSMITH_SANDBOX_CALLBACK_SIGNING_JWK
                  valueFrom:
                    secretKeyRef:
                      key: sandbox_callback_signing_jwk
                      name: langsmith-sandbox-runtime
                - name: OAUTH_AS_ISSUER
                  value: https://langsmith.example.com/api
                - name: SSRF_ALLOW_PRIVATE_IPS_CALLBACKS
                  value: "true"
                - name: SANDBOX_CALLBACK_LOOPBACK_REWRITE
                  value: "false"
                - name: SANDBOX_EGRESS_UPSTREAM_PROXY_URL
                  valueFrom:
                    secretKeyRef:
                      key: sandbox_egress_proxy_url
                      name: langsmith-sandbox-runtime
                      optional: true
                - name: LANGSMITH_SANDBOX_INTERNAL_ENDPOINT
                  value: https://langsmith.example.com/api
                - name: LANGSMITH_APP_VERSION
                  value: 0.0.0-golden
                - name: SANDBOX_HOST_DEPLOYMENT_NAME
                  value: langsmith-sandbox-sandbox-host
                - name: SANDBOX_HOST_TERMINATION_GRACE_SECONDS
                  value: "300"
                - name: SANDBOX_HOST_JUICEFS_META_URL_FILE
                  value: /run/secrets/juicefs/metaurl
                - name: SANDBOX_HOST_JUICEFS_MOUNT_OPTIONS
                  value: '["--cache-dir=/mnt/juicefs-cache","--cache-size=51200","--cache-large-write"]'
                - name: SANDBOX_HOST_JUICEFS_REDIS_IAM_AUTH_PROVIDER
                  value: azure
                - name: SANDBOX_HOST_AUTOSCALE_ENABLED
                  value: "false"
              image: docker.io/langchain/sandbox-host:0.0.0-golden
              imagePullPolicy: IfNotPresent
              name: sandbox-host
              ports:
                - containerPort: 19190
                  hostPort: 19190
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  path: /readyz
                  port: http
                initialDelaySeconds: 5
                periodSeconds: 10
                timeoutSeconds: 3
              resources:
                requests:
                  cpu: "2"
                  memory: 2Gi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /juicefs
                  name: juicefs
                - mountPath: /mnt/juicefs-cache
                  name: juicefs-cache-0
                - mountPath: /run/secrets/juicefs
                  name: juicefs-meta
                  readOnly: true
                - mountPath: /host-bin
                  name: host-bin
                - mountPath: /certs
                  name: proxy-ca
                  readOnly: true
          dnsConfig:
            options:
              - name: ndots
                value: "4"
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          nodeSelector:
            sandbox.langsmith.com/host: "true"
          securityContext: {}
          serviceAccountName: langsmith-sandbox-host
          terminationGracePeriodSeconds: 300
          tolerations:
            - effect: NoSchedule
              key: sandbox.langsmith.com/host
              operator: Equal
              value: "true"
          volumes:
            - emptyDir: {}
              name: juicefs
            - hostPath:
                path: /mnt/juicefs-cache
                type: DirectoryOrCreate
              name: juicefs-cache-0
            - name: juicefs-meta
              secret:
                defaultMode: 256
                items:
                  - key: metaurl
                    path: metaurl
                secretName: langsmith-sandbox-juicefs-config
            - name: proxy-ca
              secret:
                secretName: sandbox-proxy-ca
            - hostPath:
                path: /var/lib/sandbox-host
                type: DirectoryOrCreate
              name: host-bin
